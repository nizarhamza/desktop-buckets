<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Windows 11-flavoured control styles for Desktop Buckets.
         Every colour is a DynamicResource into the active palette
         (Palette.Light.xaml / Palette.Dark.xaml), so ThemeManager can
         flip the whole app light/dark by swapping one dictionary.
         ============================================================ -->

    <FontFamily x:Key="App.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- === typography === -->

    <Style x:Key="App.PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="App.CardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="App.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- === card === -->

    <Style x:Key="App.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.SurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- === standard button === -->

    <Style x:Key="App.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource App.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ControlFillPressed}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === accent button === -->

    <Style x:Key="App.AccentButton" TargetType="Button" BasedOn="{StaticResource App.Button}">
        <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{DynamicResource App.AccentText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentPressed}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === link button (About page) === -->

    <Style x:Key="App.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,3">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === text box === -->

    <Style x:Key="App.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Background" Value="{DynamicResource App.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === toggle switch (restyled CheckBox) === -->

    <Style x:Key="App.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{DynamicResource App.ToggleOff}"
                                    BorderBrush="{DynamicResource App.ToggleOffBorder}"
                                    BorderThickness="1.3" />
                            <Ellipse x:Name="Knob" Width="12" Height="12"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="4,0,0,0"
                                     Fill="{DynamicResource App.ToggleKnob}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="10,0,0,0"
                                          TextElement.Foreground="{DynamicResource App.TextPrimary}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource App.ToggleKnobOn}" />
                            <Setter TargetName="Knob" Property="Margin" Value="24,0,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin"
                                                            To="24,0,0,0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin"
                                                            To="4,0,0,0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === combo box === -->

    <Style x:Key="App.ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="4" Margin="4,1" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.MenuItemHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.MenuItemHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource App.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource App.ComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="5"
                                            Background="{DynamicResource App.ControlFill}"
                                            BorderBrush="{DynamicResource App.ControlBorder}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="&#xE70D;"
                                                       FontFamily="{StaticResource App.IconFont}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource App.TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ControlFillPressed}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Sel" IsHitTestVisible="False"
                                          Margin="12,0,34,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{DynamicResource App.TextPrimary}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                    Margin="0,4,0,10" CornerRadius="8"
                                    Background="{DynamicResource App.Menu}"
                                    BorderBrush="{DynamicResource App.MenuBorder}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity="0.26" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="240" Margin="0,4"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === slider === -->

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="{DynamicResource App.Accent}" />
                        <Ellipse x:Name="Core" Width="9" Height="9" Fill="{DynamicResource App.Surface}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="7" />
                            <Setter TargetName="Core" Property="Height" Value="7" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="6" />
                            <Setter TargetName="Core" Property="Height" Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderRail" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Slider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource App.ControlBorderStrong}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Style>
                                        <Style TargetType="RepeatButton" BasedOn="{StaticResource SliderRail}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                                Background="{DynamicResource App.Accent}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RepeatButton.Style>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRail}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === sidebar nav item (RadioButton) === -->

    <Style x:Key="App.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Bar" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left" Fill="{DynamicResource App.Accent}"
                                       Visibility="Hidden" />
                            <TextBlock x:Name="Glyph" Grid.Column="0" Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource App.IconFont}" FontSize="15"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SidebarSelected}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SidebarSelected}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === segmented option (theme picker) === -->

    <Style x:Key="App.SegItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" Margin="0,0,6,0"
                            Background="{DynamicResource App.ControlFill}"
                            BorderBrush="{DynamicResource App.ControlBorder}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === accent swatch (RadioButton) === -->

    <Style x:Key="App.Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource App.TextPrimary}" StrokeThickness="2"
                                 Visibility="Collapsed" />
                        <Ellipse x:Name="Dot" Margin="4" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === scroll bar (implicit, thin Win11 style) === -->

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Margin="3" MinWidth="6" MinHeight="24"
                            Background="{DynamicResource App.ControlBorderStrong}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource App.TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource App.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="12" />
                            <Setter Property="MinHeight" Value="12" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Context menus — implicit, so the code-built tile menu and the
         XAML per-file menu both pick this up. Windows 11 flyout look.
         ============================================================ -->

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="6" CornerRadius="8" MinWidth="180"
                            Background="{DynamicResource App.Menu}"
                            BorderBrush="{DynamicResource App.MenuBorder}"
                            BorderThickness="1" Padding="0,4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity="0.26" Color="#000000" />
                        </Border.Effect>
                        <ItemsPresenter Grid.IsSharedSizeScope="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="12,5" Fill="{DynamicResource App.Divider}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Margin="4,1" CornerRadius="4" Padding="0"
                            Background="Transparent">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE10B;"
                                       FontFamily="{StaticResource App.IconFont}" FontSize="12"
                                       Foreground="{DynamicResource App.MenuGlyph}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              RecognizesAccessKey="True" />

                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextTertiary}" FontSize="11.5" />

                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;"
                                       FontFamily="{StaticResource App.IconFont}" FontSize="10"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />

                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="6" CornerRadius="8" MinWidth="160"
                                        Background="{DynamicResource App.Menu}"
                                        BorderBrush="{DynamicResource App.MenuBorder}"
                                        BorderThickness="1" Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity="0.26" Color="#000000" />
                                    </Border.Effect>
                                    <ItemsPresenter Grid.IsSharedSizeScope="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.MenuItemHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

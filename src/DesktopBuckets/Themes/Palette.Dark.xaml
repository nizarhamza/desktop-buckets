<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 "dark" surface palette. Keys match Palette.Light.xaml one-for-one;
         ThemeManager swaps this whole dictionary at runtime and every consumer uses
         DynamicResource, so the UI repaints without rebuilding. -->

    <Color x:Key="App.ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="App.WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="App.Surface" Color="#2D2D2D" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#353535" />
    <SolidColorBrush x:Key="App.SurfaceBorder" Color="#3A3A3A" />
    <SolidColorBrush x:Key="App.Divider" Color="#383838" />

    <SolidColorBrush x:Key="App.Sidebar" Color="#262626" />
    <SolidColorBrush x:Key="App.SidebarSelected" Color="#333333" />

    <SolidColorBrush x:Key="App.ControlFill" Color="#383838" />
    <SolidColorBrush x:Key="App.ControlFillHover" Color="#404040" />
    <SolidColorBrush x:Key="App.ControlFillPressed" Color="#2E2E2E" />
    <SolidColorBrush x:Key="App.ControlBorder" Color="#454545" />
    <SolidColorBrush x:Key="App.ControlBorderStrong" Color="#5A5A5A" />

    <SolidColorBrush x:Key="App.TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#C7C7C7" />
    <SolidColorBrush x:Key="App.TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="App.TextOnAccent" Color="#000000" />

    <SolidColorBrush x:Key="App.Menu" Color="#2C2C2C" />
    <SolidColorBrush x:Key="App.MenuBorder" Color="#404040" />
    <SolidColorBrush x:Key="App.MenuItemHover" Color="#383838" />
    <SolidColorBrush x:Key="App.MenuGlyph" Color="#E0E0E0" />

    <SolidColorBrush x:Key="App.ToggleOff" Color="#00000000" />
    <SolidColorBrush x:Key="App.ToggleOffBorder" Color="#9E9E9E" />
    <SolidColorBrush x:Key="App.ToggleKnob" Color="#CCCCCC" />
    <SolidColorBrush x:Key="App.ToggleKnobOn" Color="#000000" />

    <SolidColorBrush x:Key="App.FocusStroke" Color="#FFFFFF" />

    <!-- Accent fallbacks; ThemeManager overrides these at the Application level from the
         config / Windows accent. Present here so a first frame (or the XAML designer)
         has something to bind to. -->
    <SolidColorBrush x:Key="App.Accent" Color="#4C8BF5" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#437FD8" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#3A6BBB" />
    <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF" />
    <Color x:Key="App.AccentColor">#4C8BF5</Color>

</ResourceDictionary>

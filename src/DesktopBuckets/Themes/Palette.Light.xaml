<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 "light" surface palette. Keys match Palette.Dark.xaml one-for-one. -->

    <Color x:Key="App.ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="App.WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="App.Surface" Color="#FBFBFB" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F0F0F0" />
    <SolidColorBrush x:Key="App.SurfaceBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="App.Divider" Color="#E5E5E5" />

    <SolidColorBrush x:Key="App.Sidebar" Color="#EDEDED" />
    <SolidColorBrush x:Key="App.SidebarSelected" Color="#E4E4E4" />

    <SolidColorBrush x:Key="App.ControlFill" Color="#FBFBFB" />
    <SolidColorBrush x:Key="App.ControlFillHover" Color="#F5F5F5" />
    <SolidColorBrush x:Key="App.ControlFillPressed" Color="#F0F0F0" />
    <SolidColorBrush x:Key="App.ControlBorder" Color="#D8D8D8" />
    <SolidColorBrush x:Key="App.ControlBorderStrong" Color="#BFBFBF" />

    <SolidColorBrush x:Key="App.TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#5D5D5D" />
    <SolidColorBrush x:Key="App.TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="App.TextOnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="App.Menu" Color="#F9F9F9" />
    <SolidColorBrush x:Key="App.MenuBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="App.MenuItemHover" Color="#ECECEC" />
    <SolidColorBrush x:Key="App.MenuGlyph" Color="#1B1B1B" />

    <SolidColorBrush x:Key="App.ToggleOff" Color="#00000000" />
    <SolidColorBrush x:Key="App.ToggleOffBorder" Color="#8A8A8A" />
    <SolidColorBrush x:Key="App.ToggleKnob" Color="#5D5D5D" />
    <SolidColorBrush x:Key="App.ToggleKnobOn" Color="#FFFFFF" />

    <SolidColorBrush x:Key="App.FocusStroke" Color="#1B1B1B" />

    <SolidColorBrush x:Key="App.Accent" Color="#4C8BF5" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#437FD8" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#3A6BBB" />
    <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF" />
    <Color x:Key="App.AccentColor">#4C8BF5</Color>

</ResourceDictionary>

<Window x:Class="DesktopBuckets.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Buckets — Settings"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow"
        Background="#FF23232A">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFECECEC" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8FA8FF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFECECEC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="150" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="Desktop Buckets" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Text="version 0.0.0" Foreground="#FF9A9AA6" Margin="0,2,0,0" />

        <!-- Updates -->
        <TextBlock Text="UPDATES" Style="{StaticResource SectionHeader}" Margin="0,20,0,8" />

        <CheckBox x:Name="AutoUpdateCheck"
                  Content="Check for updates automatically"
                  Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />

        <CheckBox x:Name="StartupCheck"
                  Content="Also check right after the app starts"
                  Margin="20,5,0,0"
                  Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Channel" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="ChannelCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                      SelectionChanged="AutoUpdate_Changed">
                <ComboBoxItem Content="Stable" Tag="stable" />
                <ComboBoxItem Content="Nightly (latest build)" Tag="nightly" />
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Check every" VerticalAlignment="Center" Margin="0,8,12,0" />
            <ComboBox x:Name="IntervalCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,8,0,0"
                      SelectionChanged="AutoUpdate_Changed">
                <ComboBoxItem Content="1 hour" Tag="1" />
                <ComboBoxItem Content="6 hours" Tag="6" />
                <ComboBoxItem Content="24 hours" Tag="24" />
            </ComboBox>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
            <Button x:Name="CheckNowButton" Content="Check now" Click="CheckNow_Click" />
            <TextBlock x:Name="CheckStatusText" Text="" Foreground="#FF9A9AA6"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <Border Height="1" Background="#FF3A3A44" Margin="0,20,0,0" />

        <!-- Startup & desktop -->
        <TextBlock Text="STARTUP &amp; DESKTOP" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />

        <CheckBox x:Name="RunAtSignInCheck"
                  Content="Start Desktop Buckets when I sign in"
                  Checked="RunAtSignIn_Changed" Unchecked="RunAtSignIn_Changed" />

        <CheckBox x:Name="ShellMenuCheck"
                  Content="Show “New Bucket” on the desktop right-click menu"
                  Checked="ShellMenu_Changed" Unchecked="ShellMenu_Changed" />
        <TextBlock Text="Turning this on asks for approval once."
                   Foreground="#FF9A9AA6" FontSize="11" Margin="20,3,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
            <Button x:Name="RealignButton" Content="Align icons to grid" Click="RealignIcons_Click" />
            <TextBlock x:Name="RealignStatusText" Text="" Foreground="#FF9A9AA6"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock Text="Snaps any desktop icon that has drifted off this app's grid. Windows' own “Align icons to grid” is kept off so it can't fight tile placement — use this instead."
                   Foreground="#FF9A9AA6" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />

        <Border Height="1" Background="#FF3A3A44" Margin="0,20,0,0" />

        <!-- Data -->
        <TextBlock Text="DATA" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
        <TextBlock Text="Settings, the bucket list and log.txt live in:" Foreground="#FF9A9AA6" FontSize="11" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="DataDirText" Text="" FontSize="11" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="290" />
            <Button Content="Open" Margin="12,0,0,0" Height="22" Padding="10,0" Click="OpenDataDir_Click" />
        </StackPanel>

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,22,0,0"
                MinWidth="90" IsCancel="True" Click="Close_Click" />
    </StackPanel>
</Window>

<Window x:Class="DesktopBuckets.Views.BucketTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Bucket"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <!-- AcrylicHelper blurs + tints the whole window and clips it to this rounded
         shape. The Border only adds the edge highlight + padding. -->
    <Border x:Name="Card"
            CornerRadius="12"
            Background="#14FFFFFF"
            BorderBrush="#3AFFFFFF"
            BorderThickness="1"
            Padding="12"
            MouseDown="Card_MouseDown">

        <StackPanel>
            <Grid x:Name="SlotArea">
                <ItemsControl x:Name="SlotsHost" ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="80" Height="80" Margin="3"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    ToolTip="{Binding Name}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1FFFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Click="Ctx_OpenFile" />
                                        <MenuItem Header="Pin to bucket"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                  Click="Ctx_TogglePin" />
                                        <Separator />
                                        <MenuItem Header="Open file location" Click="Ctx_Reveal" />
                                        <MenuItem Header="Copy path" Click="Ctx_CopyPath" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <StackPanel VerticalAlignment="Center">
                                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" />
                                        <Ellipse Width="9" Height="9"
                                                 Fill="#FFD54F"
                                                 Stroke="#661C1C1E" StrokeThickness="1"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-2,-2,0"
                                                 Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#FFECECEC"
                                               FontSize="10"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="74"
                                               MaxHeight="26"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Empty &#8212; drop files here"
                           Foreground="#80FFFFFF"
                           FontSize="11"
                           Margin="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0">
                <TextBlock Text="{Binding Name}"
                           Foreground="#FFF3F3F3"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="180" />
                <TextBlock Text="{Binding OverflowCount, StringFormat=' +{0}'}"
                           Foreground="#80FFFFFF"
                           FontSize="12"
                           Visibility="{Binding HasOverflow, Converter={StaticResource BoolVis}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

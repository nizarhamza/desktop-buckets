<Window x:Class="DesktopBuckets.Views.BucketTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bucket"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <!-- Layered translucent window: the wallpaper/icons behind show through this
         fill's alpha. AcrylicHelper additionally blurs that show-through where the OS
         allows it. -->
    <Border x:Name="Card"
            CornerRadius="12"
            Background="#7A131519"
            BorderBrush="#45FFFFFF"
            BorderThickness="1"
            Padding="8"
            MouseDown="Card_MouseDown">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid x:Name="SlotArea">
                <ItemsControl x:Name="SlotsHost" ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="70" Height="70" Margin="2"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    ToolTip="{Binding Name}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1FFFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Click="Ctx_OpenFile" />
                                        <MenuItem Header="Pin to bucket"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                  Click="Ctx_TogglePin" />
                                        <Separator />
                                        <MenuItem Header="Open file location" Click="Ctx_Reveal" />
                                        <MenuItem Header="Copy path" Click="Ctx_CopyPath" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <StackPanel VerticalAlignment="Center">
                                    <Grid Width="36" Height="36" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SnapsToDevicePixels="True" />
                                        <Ellipse Width="9" Height="9"
                                                 Fill="#FFD54F"
                                                 Stroke="#661C1C1E" StrokeThickness="1"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-2,-2,0"
                                                 Visibility="{Binding IsPinned, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#FFECECEC"
                                               FontSize="9"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="66"
                                               MaxHeight="20"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Empty &#8212; drop files here"
                           Foreground="#80FFFFFF"
                           FontSize="11"
                           Margin="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
            </Grid>

            <!-- A dedicated dark pill behind the name — not just a drop shadow —
                 guarantees contrast no matter how bright the wallpaper showing through
                 the glass card is; a shadow alone can wash out over a light background.
                 Width tracks the icon area itself (not a guessed fixed number), so it's
                 correctly sized whether the tile is a narrow 1x2 or a wide 3x3. -->
            <Border Background="#66000000"
                    CornerRadius="5"
                    Padding="7,2"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Center"
                    MaxWidth="{Binding ActualWidth, ElementName=SlotArea}">
                <TextBlock Text="{Binding Name}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           ToolTip="{Binding OverflowTooltip}" />
            </Border>
        </StackPanel>
    </Border>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!-- Sparse MSIX package: carries ONLY this manifest + Images. The app binaries
     (DesktopBuckets.exe, DesktopBuckets.ShellExt.dll) live at the external
     location passed to Add-AppxPackage -ExternalLocation.
     __VERSION__ is substituted by build-package.ps1. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
    xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
    xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
    IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <Identity Name="DesktopBuckets.ShellExt"
            Publisher="CN=DesktopBuckets Dev"
            Version="__VERSION__"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Desktop Buckets Shell Extension</DisplayName>
    <PublisherDisplayName>Desktop Buckets</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DesktopBuckets"
                 Executable="DesktopBuckets.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Desktop Buckets"
          Description="Bucket tiles on your Windows desktop"
          BackgroundColor="transparent"
          Square150x150Logo="Images\Square150x150Logo.png"
          Square44x44Logo="Images\Square44x44Logo.png"
          AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Desktop Buckets Context Menu">
              <com:Class Id="13D2D614-C25F-438C-B9DE-A842FC2B5743"
                         Path="DesktopBuckets.ShellExt.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="NewBucket" Clsid="13D2D614-C25F-438C-B9DE-A842FC2B5743" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="NewBucket" Clsid="13D2D614-C25F-438C-B9DE-A842FC2B5743" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
